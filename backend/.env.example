# 复制为 .env 并填写。.env 已被 .gitignore 排除，切勿提交。
# 本地默认 SQLite，无需以下变量即可跑；以下为生产 / Vercel 所需。

# 数据库：Vercel 演示态可留空——检测到 VERCEL 环境会自动改用 /tmp 下的临时 SQLite，
# 冷启动自动重新灌种子（数据不跨实例持久化，仅作演示）。
# 若要真实持久化（生产态），再填外部 Postgres（如 Neon / Supabase 免费层）：
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT 签名密钥：务必替换为强随机值（openssl rand -hex 32）
JWT_SECRET=change-me-to-a-strong-random-secret

# 拉取器：mock（演示态，无需企业微信权限）| wecom（真实，需 Docker+SDK+私钥）
PULLER=mock

# 演示账号（生产态应改为用户表 + 密码哈希存储）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 空库是否自动注入种子
SEED_AUTO=true
